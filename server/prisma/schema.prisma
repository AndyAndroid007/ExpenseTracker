// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  email String? @unique
  name String?
  password String?

  entries   Entry[]
  streak    Streak?
  dailyLogs DailyLog[]
  chatMessages ChatMessage[]
  pushSubscriptions PushSubscription[]
}

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      String   // 'user' | 'system'
  text        String
  type        String   @default("text") // 'text' | 'confirm_card' | 'streak'
  payload     Json?
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Asc)])
}



model Entry {
    id String @id @default(uuid()) @db.Uuid
    userId String @db.Uuid
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    rawText String
    amount Decimal? @db.Decimal(10,2)
    category String?
    type EntryType
    expenseDate DateTime @db.Date
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    confidenceLevel ConfidenceLevel
    isUserConfirmedDate Boolean @default(false)
    isDeleted Boolean @default(false)

    @@index([userId, expenseDate(sort: Desc)])
    @@index([userId, category])
}

model Streak {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak Int @default(0)
  longestStreak Int @default(0)
  lastLoggedDate DateTime? @db.Date
  freezesAvailable Int @default(2)
  lastFreezeUsedAt DateTime? @db.Date
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model DailyLog {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate DateTime @db.Date

  @@id([userId, logDate])
}

model Category {
  id   Int     @id @default(autoincrement())
  name String  @unique
  icon String?
}

model UnmappedMerchant {
  id String @id @default(uuid()) @db.Uuid
  merchantName String @unique
  categorySuggest String
  count Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([count])
}

enum EntryType {
  expense
  save_day
}

enum ConfidenceLevel {
  low
  medium
  high
}




